# ============================================================
# 4. General helper functions
# ============================================================

def normalize_longitude(lon):
    """
    Normalize longitude to [-180, 180).
    """
    lon = float(lon)

    return ((lon + 180.0) % 360.0) - 180.0


def angular_lon_difference(lon_array, center_lon):
    """
    Calculate the shortest signed longitude difference.

    The returned values are in [-180, 180).
    """
    return (
        (lon_array - center_lon + 180.0)
        % 360.0
    ) - 180.0


def rain_time_id_to_timestamp(rain_time_id):
    """
    Convert YYYYDDD.HH to a pandas Timestamp.

    Example
    -------
    1982001.03 -> 1982-01-01 03:00:00
    """
    date_part = rain_time_id[:7]
    hour_part = rain_time_id[8:10]

    date_value = pd.to_datetime(
        date_part,
        format="%Y%j",
        errors="raise",
    )

    return date_value + pd.Timedelta(
        hours=int(hour_part)
    )


def calculate_grid_area_km2(
    lat_centers,
    d_lat_deg,
    d_lon_deg,
):
    """
    Calculate exact spherical areas for regular latitude-longitude
    grid cells.

    The area formula is:

        R^2 * delta_lon *
        abs(sin(lat_north) - sin(lat_south))

    The returned unit is square kilometres.
    """
    half_dlat = d_lat_deg / 2.0

    lat_north = np.minimum(
        90.0,
        lat_centers + half_dlat,
    )

    lat_south = np.maximum(
        -90.0,
        lat_centers - half_dlat,
    )

    lat_north_rad = np.radians(
        lat_north
    )

    lat_south_rad = np.radians(
        lat_south
    )

    d_lon_rad = np.radians(
        d_lon_deg
    )

    return (
        EARTH_RADIUS_KM ** 2
        * d_lon_rad
        * np.abs(
            np.sin(lat_north_rad)
            - np.sin(lat_south_rad)
        )
    )


def calculate_distance_grid_km(
    lat_values,
    lon_values,
    center_lat,
    center_lon,
):
    """
    Calculate great-circle distances from grid-cell centres to a
    TC centre using the Haversine formula.
    """
    grid_lat_rad = np.radians(
        lat_values[:, None]
    )

    grid_lon_rad = np.radians(
        lon_values[None, :]
    )

    center_lat_rad = np.radians(
        center_lat
    )

    center_lon_rad = np.radians(
        center_lon
    )

    dlat = (
        grid_lat_rad
        - center_lat_rad
    )

    dlon = (
        grid_lon_rad
        - center_lon_rad
        + np.pi
    ) % (2.0 * np.pi) - np.pi

    a = (
        np.sin(dlat / 2.0) ** 2
        + np.cos(center_lat_rad)
        * np.cos(grid_lat_rad)
        * np.sin(dlon / 2.0) ** 2
    )

    a = np.clip(
        a,
        0.0,
        1.0,
    )

    c = 2.0 * np.arcsin(
        np.sqrt(a)
    )

    return EARTH_RADIUS_KM * c


def build_output_path(
    row_id,
    rain_time_id,
):
    """
    Construct the output path for one TC record.

    Example
    -------
    /mnt/data/C4/MSWEP/1982/
    row_000000000_1982001.00.csv.gz
    """
    year = rain_time_id[:4]

    output_dir = (
        OUTPUT_BASE_DIR
        / year
    )

    output_name = (
        f"row_{row_id:09d}_"
        f"{rain_time_id}.csv.gz"
    )

    return output_dir / output_name


def output_is_complete(output_path):
    """
    Treat an existing non-empty output as complete.

    Formal outputs are written atomically, so a formal output file
    should only appear after gzip writing has completed.
    """
    if not output_path.exists():
        return False

    try:
        if output_path.stat().st_size <= 0:
            return False
        with gzip.open(output_path, mode="rt", encoding="utf-8") as stream:
            header = stream.readline().strip().split(",")
        return header == OUTPUT_COLUMNS
    except (OSError, EOFError, gzip.BadGzipFile, UnicodeDecodeError):
        return False


def write_csv_gzip_atomic(
    df,
    output_path,
):
    """
    Write a gzip-compressed CSV atomically.

    Data are first written to a temporary file in the same
    directory. The temporary file replaces the formal output only
    after writing succeeds.
    """
    output_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temp_path = output_path.with_name(
        output_path.name
        + f".tmp.{os.getpid()}"
    )

    try:
        with gzip.open(
            temp_path,
            mode="wt",
            encoding="utf-8",
            newline="",
            compresslevel=GZIP_COMPRESS_LEVEL,
        ) as gzip_file:

            df.to_csv(
                gzip_file,
                index=False,
                columns=OUTPUT_COLUMNS,
                float_format="%.10g",
            )

        if not temp_path.exists():
            raise RuntimeError(
                "Temporary output was not created: "
                f"{temp_path}"
            )

        if temp_path.stat().st_size == 0:
            raise RuntimeError(
                "Temporary output is empty: "
                f"{temp_path}"
            )

        os.replace(
            temp_path,
            output_path,
        )

    finally:
        if temp_path.exists():
            try:
                temp_path.unlink()
            except OSError:
                pass


# ============================================================
# 5. Read and validate the BASE CSV
# ============================================================

def read_and_validate_base_csv():
    """
    Read the BASE CSV and validate all fields required for MSWEP
    extraction.

    Non-zero minutes or seconds in ISO_TIME are retained. Such
    records are matched using their existing RAIN_TIME_ID.
    """
    print("=" * 80)
    print("Reading and validating the BASE CSV")
    print("=" * 80)

    if not BASE_CSV.exists():
        raise FileNotFoundError(
            f"BASE CSV does not exist: {BASE_CSV}"
        )

    df = pd.read_csv(
        BASE_CSV,
        dtype={
            "SID": "string",
            "RAIN_TIME_ID": "string",
        },
        low_memory=False,
    )

    required_columns = {
        "SID",
        "ISO_TIME",
        "RAIN_TIME_ID",
        "USA_LAT",
        "USA_LON",
    }

    missing_columns = (
        required_columns.difference(
            df.columns
        )
    )

    if missing_columns:
        raise KeyError(
            "The BASE CSV is missing required columns: "
            + ", ".join(
                sorted(missing_columns)
            )
        )

    # ROW_ID is the zero-based row number in the BASE CSV.
    df = df.reset_index(
        drop=True
    )

    df.insert(
        0,
        "ROW_ID",
        np.arange(
            len(df),
            dtype=np.int64,
        ),
    )

    df["USA_LAT"] = pd.to_numeric(
        df["USA_LAT"],
        errors="coerce",
    )

    df["USA_LON"] = pd.to_numeric(
        df["USA_LON"],
        errors="coerce",
    )

    df["ISO_TIME"] = pd.to_datetime(
        df["ISO_TIME"],
        errors="coerce",
    )

    invalid_required_mask = (
        df["ISO_TIME"].isna()
        | df["RAIN_TIME_ID"].isna()
        | df["USA_LAT"].isna()
        | df["USA_LON"].isna()
    )

    if invalid_required_mask.any():
        examples = (
            df.loc[
                invalid_required_mask,
                [
                    "ROW_ID",
                    "SID",
                    "ISO_TIME",
                    "RAIN_TIME_ID",
                    "USA_LAT",
                    "USA_LON",
                ],
            ]
            .head(20)
            .to_dict("records")
        )

        raise ValueError(
            "Invalid required fields were found. "
            f"Count: {int(invalid_required_mask.sum())}. "
            f"Examples: {examples}"
        )

    invalid_lat_mask = (
        (df["USA_LAT"] < -90.0)
        | (df["USA_LAT"] > 90.0)
    )

    if invalid_lat_mask.any():
        examples = (
            df.loc[
                invalid_lat_mask,
                [
                    "ROW_ID",
                    "USA_LAT",
                    "USA_LON",
                ],
            ]
            .head(20)
            .to_dict("records")
        )

        raise ValueError(
            "Out-of-range latitudes were found. "
            f"Count: {int(invalid_lat_mask.sum())}. "
            f"Examples: {examples}"
        )

    df["USA_LON"] = (
        (df["USA_LON"] + 180.0)
        % 360.0
    ) - 180.0

    rain_id_format_mask = (
        df["RAIN_TIME_ID"]
        .str.fullmatch(
            r"\d{7}\.\d{2}",
            na=False,
        )
    )

    if not rain_id_format_mask.all():
        examples = (
            df.loc[
                ~rain_id_format_mask,
                [
                    "ROW_ID",
                    "RAIN_TIME_ID",
                ],
            ]
            .head(20)
            .to_dict("records")
        )

        raise ValueError(
            "Invalid RAIN_TIME_ID values were found. "
            f"Count: {int((~rain_id_format_mask).sum())}. "
            f"Examples: {examples}"
        )

    # Validate the year, day of year, and hour encoded in each ID.
    invalid_parsed_ids = []

    for rain_time_id in (
        df["RAIN_TIME_ID"]
        .drop_duplicates()
    ):
        try:
            parsed_time = (
                rain_time_id_to_timestamp(
                    rain_time_id
                )
            )

            if parsed_time.strftime(
                "%Y%j.%H"
            ) != rain_time_id:
                invalid_parsed_ids.append(
                    rain_time_id
                )

        except Exception:
            invalid_parsed_ids.append(
                rain_time_id
            )

    if invalid_parsed_ids:
        raise ValueError(
            "RAIN_TIME_ID contains invalid calendar values. "
            f"Examples: {invalid_parsed_ids[:20]}"
        )

    # The ID is intentionally based on the calendar year, day of
    # year, and listed hour in ISO_TIME. Minutes and seconds are
    # ignored for the MSWEP filename mapping.
    expected_rain_id = (
        df["ISO_TIME"]
        .dt.strftime("%Y%j.%H")
    )

    mismatch_mask = (
        expected_rain_id
        != df["RAIN_TIME_ID"]
    )

    if mismatch_mask.any():
        examples = (
            df.loc[
                mismatch_mask,
                [
                    "ROW_ID",
                    "ISO_TIME",
                    "RAIN_TIME_ID",
                ],
            ]
            .assign(
                EXPECTED_RAIN_TIME_ID=(
                    expected_rain_id[
                        mismatch_mask
                    ].values
                )
            )
            .head(20)
            .to_dict("records")
        )

        raise ValueError(
            "ISO_TIME and RAIN_TIME_ID are inconsistent. "
            f"Count: {int(mismatch_mask.sum())}. "
            f"Examples: {examples}"
        )

    # Preserve and report records that are not exactly on the hour.
    non_exact_hour_mask = (
        (df["ISO_TIME"].dt.minute != 0)
        | (df["ISO_TIME"].dt.second != 0)
        | (df["ISO_TIME"].dt.microsecond != 0)
    )

    non_exact_hour_count = int(
        non_exact_hour_mask.sum()
    )

    if non_exact_hour_count > 0:
        LOG_DIR.mkdir(
            parents=True,
            exist_ok=True,
        )

        non_exact_log_path = (
            LOG_DIR
            / "non_exact_hour_records.csv"
        )

        non_exact_columns = [
            "ROW_ID",
            "SID",
            "ISO_TIME",
            "RAIN_TIME_ID",
            "USA_LAT",
            "USA_LON",
        ]

        df.loc[
            non_exact_hour_mask,
            non_exact_columns,
        ].to_csv(
            non_exact_log_path,
            index=False,
            date_format="%Y-%m-%d %H:%M:%S",
        )

        print(
            "Warning: "
            f"{non_exact_hour_count} records are not exactly "
            "on the hour."
        )

        print(
            "They will be matched using their existing "
            "RAIN_TIME_ID."
        )

        print(
            f"Audit file: {non_exact_log_path}"
        )

    duplicate_mask = df.duplicated(
        subset=[
            "SID",
            "ISO_TIME",
        ],
        keep=False,
    )

    if duplicate_mask.any():
        examples = (
            df.loc[
                duplicate_mask,
                [
                    "ROW_ID",
                    "SID",
                    "ISO_TIME",
                    "RAIN_TIME_ID",
                ],
            ]
            .head(20)
            .to_dict("records")
        )

        raise ValueError(
            "Duplicate SID + ISO_TIME records were found. "
            f"Count: {int(duplicate_mask.sum())}. "
            f"Examples: {examples}"
        )

    print(f"Total TC records: {len(df)}")

    print(
        "Unique RAIN_TIME_ID values: "
        f"{df['RAIN_TIME_ID'].nunique()}"
    )

    print(
        "ISO_TIME range: "
        f"{df['ISO_TIME'].min()} to "
        f"{df['ISO_TIME'].max()}"
    )

    print(
        "Non-exact-hour records: "
        f"{non_exact_hour_count}"
    )

    if TEST_MODE:
        test_rows = min(
            TEST_MAX_ROWS,
            len(df),
        )

        df = df.iloc[
            :test_rows
        ].copy()

        print(
            f"TEST_MODE is enabled. Processing only "
            f"the first {len(df)} TC records."
        )

    else:
        print(
            "TEST_MODE is disabled. Processing the full dataset."
        )

    return df


# ============================================================
# 6. Build multiprocessing tasks
# ============================================================

def generate_tasks(df):
    """
    Group TC records by RAIN_TIME_ID.

    Each task opens one MSWEP file and processes every TC record
    associated with that file.
    """
    grouped = df.groupby(
        "RAIN_TIME_ID",
        sort=True,
    )

    for rain_time_id, group in grouped:
        records = list(
            zip(
                group["ROW_ID"].to_numpy(dtype=np.int64).tolist(),
                group["USA_LAT"].to_numpy(dtype=np.float64).tolist(),
                group["USA_LON"].to_numpy(dtype=np.float64).tolist(),
            )
        )

        yield (
            str(rain_time_id),
            records,
        )


# ============================================================
# 7. Extract a 500-km grid for one TC record
# ============================================================

def extract_tc_grid(
    precipitation,
    all_lat,
    all_lon,
    all_area_by_lat,
    d_lat_deg,
    d_lon_deg,
    center_lat,
    center_lon,
):
    """
    Extract every MSWEP grid cell whose centre is within 500 km
    of the TC centre.
    """
    center_lon = normalize_longitude(
        center_lon
    )

    radius_lat_deg = np.degrees(
        RADIUS_KM
        / EARTH_RADIUS_KM
    )

    lat_margin_deg = (
        radius_lat_deg
        + d_lat_deg / 2.0
        + 0.05
    )

    lat_candidate_mask = (
        np.abs(
            all_lat - center_lat
        )
        <= lat_margin_deg
    )

    lat_indices = np.flatnonzero(
        lat_candidate_mask
    )

    if lat_indices.size == 0:
        raise RuntimeError(
            "No candidate latitude cells were found."
        )

    candidate_lat = all_lat[
        lat_indices
    ]

    max_abs_lat = min(
        89.999,
        float(
            np.max(
                np.abs(candidate_lat)
            )
        ),
    )

    cos_lat = np.cos(
        np.radians(max_abs_lat)
    )

    if cos_lat <= 1e-6:
        lon_candidate_mask = np.ones(
            all_lon.shape,
            dtype=bool,
        )

    else:
        lon_margin_deg = (
            radius_lat_deg
            / cos_lat
            + d_lon_deg / 2.0
            + 0.05
        )

        if lon_margin_deg >= 180.0:
            lon_candidate_mask = np.ones(
                all_lon.shape,
                dtype=bool,
            )

        else:
            lon_difference = (
                angular_lon_difference(
                    all_lon,
                    center_lon,
                )
            )

            lon_candidate_mask = (
                np.abs(lon_difference)
                <= lon_margin_deg
            )

    lon_indices = np.flatnonzero(
        lon_candidate_mask
    )

    if lon_indices.size == 0:
        raise RuntimeError(
            "No candidate longitude cells were found."
        )

    candidate_lon = all_lon[
        lon_indices
    ]

    distance_grid = (
        calculate_distance_grid_km(
            candidate_lat,
            candidate_lon,
            center_lat,
            center_lon,
        )
    )

    radius_mask = (
        distance_grid
        <= RADIUS_KM
    )

    if not radius_mask.any():
        raise RuntimeError(
            "No grid-cell centres were found within 500 km."
        )

    precip_subset = (
        precipitation.isel(
            lat=lat_indices,
            lon=lon_indices,
        )
        .load()
        .values
    )

    precip_subset = np.asarray(
        precip_subset,
        dtype=np.float32,
    )

    expected_shape = (
        len(candidate_lat),
        len(candidate_lon),
    )

    if precip_subset.shape != expected_shape:
        raise RuntimeError(
            "Unexpected precipitation subset shape: "
            f"{precip_subset.shape}; expected {expected_shape}."
        )

    lat_grid = np.broadcast_to(
        candidate_lat[:, None],
        distance_grid.shape,
    )

    lon_grid = np.broadcast_to(
        candidate_lon[None, :],
        distance_grid.shape,
    )

    area_by_lat = all_area_by_lat[lat_indices]

    area_grid = np.broadcast_to(
        area_by_lat[:, None],
        distance_grid.shape,
    )

    selected_lat = (
        lat_grid[radius_mask]
    )

    selected_lon = (
        lon_grid[radius_mask]
    )

    selected_precip = (
        precip_subset[radius_mask]
    )

    selected_distance = (
        distance_grid[radius_mask]
    )

    selected_area = (
        area_grid[radius_mask]
    )

    # Unit conversion:
    # mm * km^2 * 1000 = m^3
    rain_volume_m3 = (
        selected_precip.astype(
            np.float64
        )
        * selected_area.astype(
            np.float64
        )
        * 1000.0
    )

    result = pd.DataFrame(
        {
            "LAT": selected_lat.astype(
                np.float32
            ),
            "LON": selected_lon.astype(
                np.float32
            ),
            "PRECIP_3H": (
                selected_precip.astype(
                    np.float32
                )
            ),
            "DIST_KM": (
                selected_distance.astype(
                    np.float32
                )
            ),
            "AREA_KM2": (
                selected_area.astype(
                    np.float32
                )
            ),
            "RAIN_VOLUME_M3": (
                rain_volume_m3.astype(
                    np.float64
                )
            ),
        }
    )

    result = result.sort_values(
        "DIST_KM",
        kind="mergesort",
    ).reset_index(
        drop=True
    )

    return result


# ============================================================
# 8. Process one RAIN_TIME_ID
# ============================================================

def process_single_rain_time(task):
    """
    Open one MSWEP file and process every TC record associated
    with that RAIN_TIME_ID.
    """
    rain_time_id, records = task

    year = rain_time_id[:4]

    nc_path = (
        MSWEP_BASE_DIR
        / year
        / f"{rain_time_id}.nc"
    )

    total_records = len(records)

    task_result = {
        "RAIN_TIME_ID": rain_time_id,
        "NC_PATH": str(nc_path),
        "TOTAL_RECORDS": total_records,
        "SUCCESS": 0,
        "SKIPPED_EXISTING": 0,
        "MISSING_FILE": 0,
        "FAILED": 0,
        "NAN_PRECIP_GRIDS": 0,
        "OUTPUT_GRIDS": 0,
        "STATUS": "UNKNOWN",
        "ERROR": "",
    }

    if not nc_path.exists():
        task_result["MISSING_FILE"] = (
            total_records
        )

        task_result["STATUS"] = (
            "MISSING_FILE"
        )

        return task_result

    pending_records = []

    for record in records:
        row_id = record[0]

        output_path = build_output_path(
            row_id,
            rain_time_id,
        )

        if (
            SKIP_EXISTING
            and output_is_complete(
                output_path
            )
        ):
            task_result[
                "SKIPPED_EXISTING"
            ] += 1

        else:
            pending_records.append(
                record
            )

    if not pending_records:
        task_result["STATUS"] = (
            "ALL_EXISTING"
        )

        return task_result

    try:
        with xr.open_dataset(
            nc_path,
            decode_times=True,
            mask_and_scale=True,
            cache=False,
        ) as ds:

            required_coords = {
                "lat",
                "lon",
                "time",
            }

            missing_coords = (
                required_coords.difference(
                    ds.coords
                )
            )

            if missing_coords:
                raise KeyError(
                    "NetCDF is missing coordinates: "
                    + ", ".join(
                        sorted(missing_coords)
                    )
                )

            if "precipitation" not in ds:
                raise KeyError(
                    "NetCDF does not contain the "
                    "precipitation variable."
                )

            if ds.sizes.get("time") != 1:
                raise ValueError(
                    "NetCDF time dimension is not 1: "
                    f"{ds.sizes.get('time')}"
                )

            file_time = pd.Timestamp(
                ds["time"].values[0]
            )

            # The expected NetCDF time comes from RAIN_TIME_ID,
            # not directly from the potentially non-exact ISO_TIME.
            expected_file_time = (
                rain_time_id_to_timestamp(
                    rain_time_id
                )
            )

            if file_time != expected_file_time:
                raise ValueError(
                    "NetCDF time does not match RAIN_TIME_ID: "
                    f"file_time={file_time}, "
                    f"expected={expected_file_time}"
                )

            all_lat = np.asarray(
                ds["lat"].values,
                dtype=np.float64,
            )

            all_lon = np.asarray(
                ds["lon"].values,
                dtype=np.float64,
            )

            if (
                all_lat.ndim != 1
                or all_lon.ndim != 1
            ):
                raise ValueError(
                    "lat and lon must both be one-dimensional."
                )

            if (
                len(all_lat) < 2
                or len(all_lon) < 2
            ):
                raise ValueError(
                    "Latitude or longitude coordinate is too short."
                )

            d_lat_deg = float(
                np.median(
                    np.abs(
                        np.diff(all_lat)
                    )
                )
            )

            d_lon_deg = float(
                np.median(
                    np.abs(
                        np.diff(all_lon)
                    )
                )
            )

            if (
                not np.isfinite(d_lat_deg)
                or not np.isfinite(d_lon_deg)
                or d_lat_deg <= 0
                or d_lon_deg <= 0
            ):
                raise ValueError(
                    "Invalid grid resolution: "
                    f"d_lat={d_lat_deg}, "
                    f"d_lon={d_lon_deg}"
                )

            precipitation = (
                ds["precipitation"]
                .isel(time=0)
            )

            if set(
                precipitation.dims
            ) != {"lat", "lon"}:
                raise ValueError(
                    "Unexpected precipitation dimensions after "
                    f"removing time: {precipitation.dims}"
                )

            precipitation = (
                precipitation.transpose(
                    "lat",
                    "lon",
                )
            )

            # Grid-cell areas depend only on latitude and grid resolution.
            # Compute them once per MSWEP file instead of once per TC record.
            all_area_by_lat = calculate_grid_area_km2(
                all_lat,
                d_lat_deg,
                d_lon_deg,
            )

            for (
                row_id,
                center_lat,
                center_lon,
            ) in pending_records:

                output_path = build_output_path(
                    row_id,
                    rain_time_id,
                )

                try:
                    result = extract_tc_grid(
                        precipitation=precipitation,
                        all_lat=all_lat,
                        all_lon=all_lon,
                        all_area_by_lat=all_area_by_lat,
                        d_lat_deg=d_lat_deg,
                        d_lon_deg=d_lon_deg,
                        center_lat=center_lat,
                        center_lon=center_lon,
                    )

                    if result.empty:
                        raise RuntimeError(
                            "The extracted grid is empty."
                        )

                    nan_precip_count = int(
                        result[
                            "PRECIP_3H"
                        ].isna().sum()
                    )

                    task_result[
                        "NAN_PRECIP_GRIDS"
                    ] += nan_precip_count

                    task_result[
                        "OUTPUT_GRIDS"
                    ] += len(result)

                    write_csv_gzip_atomic(
                        result,
                        output_path,
                    )

                    task_result[
                        "SUCCESS"
                    ] += 1

                except Exception as row_error:
                    task_result[
                        "FAILED"
                    ] += 1

                    error_text = (
                        f"ROW_ID={row_id}: "
                        f"{type(row_error).__name__}: "
                        f"{row_error}"
                    )

                    if task_result["ERROR"]:
                        task_result["ERROR"] += (
                            " | " + error_text
                        )
                    else:
                        task_result["ERROR"] = (
                            error_text
                        )

        if task_result["FAILED"] > 0:
            task_result["STATUS"] = (
                "PARTIAL_FAILURE"
            )

        elif task_result["SUCCESS"] > 0:
            task_result["STATUS"] = (
                "SUCCESS"
            )

        else:
            task_result["STATUS"] = (
                "NO_NEW_OUTPUT"
            )

    except Exception as file_error:
        task_result["FAILED"] += len(
            pending_records
        )

        task_result["STATUS"] = (
            "FILE_ERROR"
        )

        task_result["ERROR"] = (
            f"{type(file_error).__name__}: "
            f"{file_error}"
        )

    return task_result


# ============================================================
# 9. Save processing logs
# ============================================================

def save_processing_logs(results):
    """
    Save the time-task log, error log, and overall summary.
    """
    LOG_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    results_df = pd.DataFrame(
        results
    )

    task_log_path = (
        LOG_DIR
        / "processing_task_log.csv"
    )

    results_df.to_csv(
        task_log_path,
        index=False,
    )

    error_mask = (
        results_df["STATUS"].isin(
            [
                "MISSING_FILE",
                "FILE_ERROR",
                "PARTIAL_FAILURE",
            ]
        )
        | (
            results_df["FAILED"]
            > 0
        )
    )

    error_log_path = (
        LOG_DIR
        / "processing_error_log.csv"
    )

    results_df.loc[
        error_mask
    ].to_csv(
        error_log_path,
        index=False,
    )

    summary = {
        "TASK_COUNT": int(
            len(results_df)
        ),
        "TC_RECORD_COUNT": int(
            results_df[
                "TOTAL_RECORDS"
            ].sum()
        ),
        "SUCCESS_COUNT": int(
            results_df[
                "SUCCESS"
            ].sum()
        ),
        "SKIPPED_EXISTING_COUNT": int(
            results_df[
                "SKIPPED_EXISTING"
            ].sum()
        ),
        "MISSING_FILE_COUNT": int(
            results_df[
                "MISSING_FILE"
            ].sum()
        ),
        "FAILED_COUNT": int(
            results_df[
                "FAILED"
            ].sum()
        ),
        "OUTPUT_GRID_COUNT": int(
            results_df[
                "OUTPUT_GRIDS"
            ].sum()
        ),
        "NAN_PRECIP_GRID_COUNT": int(
            results_df[
                "NAN_PRECIP_GRIDS"
            ].sum()
        ),
    }

    summary_df = pd.DataFrame(
        [summary]
    )

    summary_path = (
        LOG_DIR
        / "processing_summary.csv"
    )

    summary_df.to_csv(
        summary_path,
        index=False,
    )

    return (
        summary,
        task_log_path,
        error_log_path,
        summary_path,
    )


# ============================================================
# 10. Main program
# ============================================================

def main():
    OUTPUT_BASE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    LOG_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    df = read_and_validate_base_csv()

    total_tasks = int(
        df["RAIN_TIME_ID"].nunique()
    )

    print("\n" + "=" * 80)
    print("Starting MSWEP 500-km grid extraction")
    print("=" * 80)

    print(f"TC records: {len(df)}")
    print(f"Time tasks: {total_tasks}")
    print(f"Worker processes: {MAX_WORKERS}")
    print(f"Extraction radius: {RADIUS_KM:.1f} km")
    print(f"Output directory: {OUTPUT_BASE_DIR}")
    print("Output format: gzip-compressed CSV")
    print(
        "Rain-volume formula: "
        "PRECIP_3H * AREA_KM2 * 1000"
    )
    print()

    results = []

    task_iterator = generate_tasks(
        df
    )

    with Pool(
        processes=MAX_WORKERS,
        maxtasksperchild=500,
    ) as pool:

        result_iterator = (
            pool.imap_unordered(
                process_single_rain_time,
                task_iterator,
                chunksize=POOL_CHUNKSIZE,
            )
        )

        for result in tqdm(
            result_iterator,
            total=total_tasks,
            desc="MSWEP time tasks",
            unit="time",
        ):
            results.append(
                result
            )

    if not results:
        raise RuntimeError(
            "No processing results were produced."
        )

    (
        summary,
        task_log_path,
        error_log_path,
        summary_path,
    ) = save_processing_logs(
        results
    )

    print("\n" + "=" * 80)
    print("Processing completed")
    print("=" * 80)

    print(
        f"Time tasks: "
        f"{summary['TASK_COUNT']}"
    )

    print(
        f"TC records: "
        f"{summary['TC_RECORD_COUNT']}"
    )

    print(
        f"New successful outputs: "
        f"{summary['SUCCESS_COUNT']}"
    )

    print(
        f"Existing outputs skipped: "
        f"{summary['SKIPPED_EXISTING_COUNT']}"
    )

    print(
        f"Missing MSWEP files: "
        f"{summary['MISSING_FILE_COUNT']}"
    )

    print(
        f"Failed TC records: "
        f"{summary['FAILED_COUNT']}"
    )

    print(
        f"Newly written grid rows: "
        f"{summary['OUTPUT_GRID_COUNT']}"
    )

    print(
        f"NaN precipitation grid rows: "
        f"{summary['NAN_PRECIP_GRID_COUNT']}"
    )

    print(f"\nTask log: {task_log_path}")
    print(f"Error log: {error_log_path}")
    print(f"Summary log: {summary_path}")

    if TEST_MODE:
        print(
            "\nTEST_MODE is enabled. Validate the outputs, "
            "then set TEST_MODE = False for the full run."
        )


if __name__ == "__main__":
    main()
